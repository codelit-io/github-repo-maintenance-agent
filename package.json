    "test:fixture": "node --test fixtures/project/test",
    "verify": "node bin/repo-maintenance.mjs --help && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "openai": "^7.1.0"
  }
