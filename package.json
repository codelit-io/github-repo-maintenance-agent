{
  "name": "@codelit/github-repo-maintenance-agent",
  "version": "1.0.0",
  "description": "BYOK issue-to-reviewed-patch runner with path limits, checks, and draft-PR-only GitHub output.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "repo-maintenance": "bin/repo-maintenance.mjs"
  },
  "files": [
    "agent-workflow",
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "maintain": "node bin/repo-maintenance.mjs",
